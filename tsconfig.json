{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    // Source runs directly under --experimental-strip-types, so nothing is
    // compiled and .ts import specifiers are correct. `npm run build` is a
    // typecheck, named honestly.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
