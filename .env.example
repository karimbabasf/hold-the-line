# Telnyx
TELNYX_API_KEY=
TELNYX_NUMBER=
TELNYX_ASSISTANT_ID=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# TrueForge harness
TRUEFORGE_BASE_URL=http://localhost:8790

# Bearer token Telnyx presents to our endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEPHONY_SHARED_SECRET=

# Bearer token the claim tools (8792) present to telephony (8791) to write
# live events onto the operator console. Optional: scripts/start.sh generates
# one and hands it to both processes when this is empty. Set it only if you
# run the two processes by hand, and set the same value for both, or the
# console shows nothing during a live call. Same generator as above.
CONSOLE_INGEST_SECRET=

# Daytona sandbox
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Public URL the telephony provider calls back on
PUBLIC_BASE_URL=
